generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SummaryFormat {
  paragraph
  bullet_points
  study_notes
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  createdAt     DateTime @default(now())

  settings      UserSettings?
  clips         Clip[]
  summaries     ClipSummary[]
  usage         UsageMonthly[]

  accounts      Account[]
  sessions      Session[]

  image         String?
  emailVerified DateTime?
}

model UserSettings {
  userId               String        @id
  aiEnabled            Boolean       @default(false)
  defaultSummaryFormat SummaryFormat @default(bullet_points)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Clip {
  id        String   @id @default(cuid())
  userId    String
  sourceId  String?
  text      String
  url       String?
  title     String?
  createdAt DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  summaries ClipSummary[]

  @@unique([userId, sourceId])
}

model ClipSummary {
  id            String        @id @default(cuid())
  userId        String
  clipId        String
  format        SummaryFormat
  model         String
  promptVersion Int           @default(1)
  inputHash     String
  summaryTitle  String?
  summaryBody   String
  status        String        @default("completed")
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId, format])
  @@unique([clipId, format, model, promptVersion, inputHash])
}

model UsageMonthly {
  id           String   @id @default(cuid())
  userId       String
  monthStart   DateTime
  summaryCount Int      @default(0)
  limit        Int      @default(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthStart])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
